# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude environment .tfvar and .tfvars files, which can contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvar
*.tfvars
*.tfvars.json
!infra/*/example.tfvars
!infra/frontend/dev.tfvars
!infra/foundry/dev.tfvars
!infra/gateway/dev.tfvars
!infra/logging/dev.tfvars

# Local backend initialization inputs
*.tfbackend
*.backend.hcl

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore saved Terraform plan files, which may contain sensitive values
*.tfplan
*.plan

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Generated plans and their exports
tfplan
tfplan.*
*.tfplan
*.tfplan.*

# Ignore CLI configuration files
.terraformrc
terraform.rc
